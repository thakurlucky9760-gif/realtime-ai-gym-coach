# Streamlit Secrets (for local development or Streamlit Community Cloud)
# Rename this file to secrets.toml or configure in Streamlit Cloud Dashboard
GROQ_API_KEY = "your_groq_api_key_here"

# (Optional) Twilio TURN configuration for strict networks / enterprise firewalls
# TWILIO_ACCOUNT_SID = "your_twilio_account_sid_here"
# TWILIO_AUTH_TOKEN = "your_twilio_auth_token_here"

# (Optional) Custom TURN server configuration
# TURN_SERVER_URL = "turn:your-turn-server.com:3478"
# TURN_USERNAME = "your_username"
# TURN_PASSWORD = "your_password"

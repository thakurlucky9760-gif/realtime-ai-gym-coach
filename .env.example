# Groq API Configuration
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Default LLM Model (supported: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# (Optional) Twilio TURN configuration for enterprise firewalls / cloud deployments
# TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# (Optional) Custom TURN server configuration
# TURN_SERVER_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=your_username
# TURN_PASSWORD=your_password


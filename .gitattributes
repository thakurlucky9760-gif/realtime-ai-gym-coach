# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.py text diff=python
*.md text
*.toml text
*.txt text
*.css text
*.json text
*.yml text
*.yaml text
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.task binary
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.db binary
